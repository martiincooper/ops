# Copiar a .env (Docker) o .env.local (sin Docker) y completar.

# Obligatorio: secreto de firma de sesiones (>= 32 caracteres). Generar con: openssl rand -hex 32
JWT_SECRET=

# Administrador que se crea en el primer arranque (solo si la base no tiene usuarios).
ADMIN_EMAIL=martin@aether-tech.dev
ADMIN_NOMBRE=Martin

# Código inicial de 6 dígitos para cuentas nuevas o reseteadas (se exige cambiarlo en el primer ingreso).
PIN_INICIAL=000000

# Zona horaria de negocio: define qué fecha es "hoy" (una jornada por día). No hay horarios.
TZ_NEGOCIO=America/Santiago

# true detrás de HTTPS (producción). Poner false SOLO para probar en http://localhost.
COOKIE_SECURE=true

# Solo Docker: carpeta del anfitrión para los datos. Vacío = volumen de Docker "aether-data".
# En el servidor: AETHER_DATA=/var/lib/aether-ops
# AETHER_DATA=

# Solo sin Docker: carpeta de datos (por defecto ./data)
# DATA_DIR=./data

# Empresas que comparten el sitio: clave|Nombre|dominios (separadas por ;). El dominio del email decide la empresa.
# EMPRESAS=aether-tech|Aether Tech|aether-tech.dev;datasheq|Datasheq|datasheq.cl

# Opcional: fija el dólar (pesos por 1 USD) para convertir las compras en dólares. Vacío = dólar observado del día
# (mindicador.cl; si no responde, open.er-api.com). Útil para pruebas o servidores sin salida a internet.
# TIPO_CAMBIO_USD=950
